# --- Stellar network (MVP: always testnet) ---
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org

# --- Postgres ---
# Local dev: docker run --name lumenaid-db -e POSTGRES_PASSWORD=lumenaid -e POSTGRES_DB=lumenaid -p 5432:5432 -d postgres:16
DATABASE_URL=postgresql://postgres:lumenaid@localhost:5432/lumenaid

# --- Server ---
PORT=4000
CORS_ORIGIN=http://localhost:5173

# --- Simple admin gate for MVP (no real auth system yet) ---
# Sent as `x-admin-key` header by the Admin UI. Change this before showing the app to anyone.
ADMIN_KEY=change-me-local-dev-only
