VITE_API_URL=http://localhost:4000
VITE_STELLAR_NETWORK=testnet
VITE_HORIZON_URL=https://horizon-testnet.stellar.org

# NOTE: there is no VITE_ADMIN_KEY here on purpose. Baking the admin secret
# into the frontend build would ship it in the public JS bundle. The Admin
# page instead prompts for the key at runtime and keeps it in
# sessionStorage only -- see src/pages/Admin.jsx.
